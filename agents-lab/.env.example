# Copy to .env and fill in locally. Never commit an API key.
PROVIDER=openai
OPENAI_API_KEY=
# Organizer: choose an exact model ID after a pilot. There is no default model.
MODEL=
# For PROVIDER=openrouter, set MODEL to an exact OpenRouter model ID.
OPENROUTER_API_KEY=
# For PROVIDER=local, set MODEL to the name served by your compatible server.
# Examples: http://localhost:11434/v1 (Ollama), http://localhost:8000/v1 (vLLM).
MODEL_BASE_URL=
# Optional for an unauthenticated local server; never falls back to a hosted key.
LOCAL_API_KEY=
